# Auto-detect text files and normalize line endings to LF on check-in
* text=auto eol=lf

# C# source files
*.cs text diff=csharp
*.csproj text
*.slnx text
*.sln text
*.props text
*.targets text

# XAML
*.xaml text

# XML / config
*.xml text
*.json text
*.plist text
*.manifest text

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary
*.dylib binary
